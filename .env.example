# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Free Drive (no Google Cloud Console) — Apps Script web app
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_APPS_SCRIPT_URL=
DRIVE_BRIDGE_SECRET=

# Optional paid/console path (not required)
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
